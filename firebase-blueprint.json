{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firestore-blueprint.json",
  "entities": {
    "users": {
      "description": "Usuarios habilitados para acceder y ejecutar la plataforma de corrección",
      "properties": {
        "email": {
          "type": "string",
          "description": "Correo electrónico del usuario"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "evaluator", "viewer"],
          "description": "Rol de permisos del usuario"
        },
        "displayName": {
          "type": "string",
          "description": "Nombre visible del usuario"
        },
        "photoURL": {
          "type": "string",
          "description": "URL del avatar de Google"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "pending"],
          "description": "Estado de habilitación de acceso"
        },
        "createdBy": {
          "type": "string",
          "description": "Email del administrador que autorizó al usuario"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp ISO de creación"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp ISO de última modificación"
        }
      },
      "required": ["email", "role", "status"]
    },
    "access_requests": {
      "description": "Solicitudes de acceso pendientes de aprobación por el admin",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email solicitante"
        },
        "displayName": {
          "type": "string",
          "description": "Nombre del solicitante"
        },
        "photoURL": {
          "type": "string",
          "description": "Foto de Google del solicitante"
        },
        "requestedAt": {
          "type": "string",
          "description": "Fecha y hora de solicitud"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Estado de la solicitud"
        }
      },
      "required": ["email", "requestedAt", "status"]
    },
    "evaluations_history": {
      "description": "Registro histórico y trazabilidad de todas las revisiones y evaluaciones ejecutadas",
      "properties": {
        "repoUrl": {
          "type": "string",
          "description": "URL o preset del repositorio evaluado"
        },
        "repoName": {
          "type": "string",
          "description": "Nombre del repositorio"
        },
        "owner": {
          "type": "string",
          "description": "Owner u organización de GitHub"
        },
        "nota_final": {
          "type": "number",
          "description": "Calificación numérica final de la evaluación sobre 100"
        },
        "provider": {
          "type": "string",
          "description": "Proveedor LLM o motor utilizado (gemini, anthropic, motor_calibrado)"
        },
        "modelo": {
          "type": "string",
          "description": "Modelo de IA específico utilizado"
        },
        "salud_tecnica": {
          "type": "number",
          "description": "Puntaje forense de salud técnica 0-100"
        },
        "nivel_riesgo": {
          "type": "string",
          "description": "Nivel de riesgo operativo determinado"
        },
        "evaluator_email": {
          "type": "string",
          "description": "Email del usuario que corrió la evaluación"
        },
        "evaluator_name": {
          "type": "string",
          "description": "Nombre del evaluador"
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp ISO de ejecución"
        },
        "mode": {
          "type": "string",
          "enum": ["live", "batch", "comparador"],
          "description": "Modo en que se ejecutó la evaluación"
        }
      },
      "required": ["repoUrl", "nota_final", "timestamp"]
    }
  }
}
